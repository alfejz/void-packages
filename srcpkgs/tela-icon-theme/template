# Template file for 'tela-icon-theme'
pkgname=tela-icon-theme
version=2025.02.10
revision=1
#archs="i686 x86_64"
metapackage="yes"
depends="tela-icon-theme-standard tela-icon-theme-black tela-icon-theme-blue
 tela-icon-theme-brown tela-icon-theme-green tela-icon-theme-grey
 tela-icon-theme-orange tela-icon-theme-pink tela-icon-theme-purple
 tela-icon-theme-red tela-icon-theme-yellow tela-icon-theme-manjaro
 tela-icon-theme-ubuntu tela-icon-theme-nord tela-icon-theme-dracula"
short_desc="A flat colorful icon theme (Metapackage) - All variants"
maintainer="alfejz <alfredoejz@mailo.com>"
license="GPL-3.0-only"
homepage="https://github.com/vinceliuice/Tela-icon-theme"
changelog="https://github.com/vinceliuice/Tela-icon-theme/releases/tag/${version//./-}"
distfiles="https://github.com/vinceliuice/Tela-icon-theme/archive/refs/tags/${version//./-}.tar.gz"
checksum=b1f3e76e307bd48b17f0bf55d2f5a7ce9f445b127f427e11f79a632a79e3cf4f

# Disable these, this package only contains icons files and aren´t need
# also leave them enabled makes this package build more slower
noshlibsprovides="yes"
nostrip="yes"
noverifyrdeps="yes"

do_install() {
	./install.sh -a -c -d "${DESTDIR}/usr/share/icons"
}

tela-icon-theme-standard_package() {
	short_desc="A flat colorful icon theme"
	depends="gtk-update-icon-cache"
	triggers="gtk-icon-cache"
	pkg_install() {
		vmove usr/share/icons/Tela
		vmove usr/share/icons/Tela-dark
		vmove usr/share/icons/Tela-light
	}
}

