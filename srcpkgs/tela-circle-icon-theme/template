# Template file for 'tela-circle-icon-theme'
pkgname=tela-circle-icon-theme
version=2025.02.10
revision=1
#archs="i686 x86_64"
metapackage="yes"
hostmakedepends=""
makedepends=""
depends="tela-circle-icon-theme-standard tela-circle-icon-theme-black
 tela-circle-icon-theme-blue tela-circle-icon-theme-brown tela-circle-icon-theme-green
 tela-circle-icon-theme-grey tela-circle-icon-theme-orange tela-circle-icon-theme-pink
 tela-circle-icon-theme-purple tela-circle-icon-theme-red tela-circle-icon-theme-yellow
 tela-circle-icon-theme-manjaro tela-circle-icon-theme-ubuntu tela-circle-icon-theme-dracula
 tela-circle-icon-theme-nord"
short_desc="A flat colorful rounded icon theme (metapackage with all variants)"
maintainer="alfejz <alfredoejz@mailo.com>"
license="GPL-3.0-only"
homepage="https://github.com/vinceliuice/Tela-circle-icon-theme"
changelog="https://github.com/vinceliuice/Tela-circle-icon-theme/releases/tag/${version//./-}"
distfiles="https://github.com/vinceliuice/Tela-circle-icon-theme/archive/refs/tags/${version//./-}.tar.gz"
checksum=61dece3ab25711af9516565dd300d23b1c532fe69eac5cad42d2e9c57fa7c331

# Disable these, this package only contains icons files and aren´t need
# also leave them enabled makes this package build more slower
noshlibsprovides="yes"
nostrip="yes"
noverifyrdeps="yes"

do_install() {
	./install.sh -a -c -d "$DESTDIR/usr/share/icons"
}

tela-circle-icon-theme-standard_package() {
	short_desc="A flat colorful rounded icon theme"
	depends="gtk-update-icon-cache"
	triggers="gtk-icon-cache"
	pkg_install() {
		vmove usr/share/icons/Tela-circle
		vmove usr/share/icons/Tela-circle-dark
		vmove usr/share/icons/Tela-circle-light
	}
}

